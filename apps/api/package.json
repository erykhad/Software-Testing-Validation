{
  "name": "@shopping/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts src/domain",
    "test:integration": "vitest run --config vitest.config.ts src/integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "hono": "^4.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
